<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lista de Interessados</title>

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>

        /* ============================= */
        /* RESET */
        /* ============================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Rubik', Arial, Helvetica, sans-serif;
            min-height: 100vh;

            background:
                linear-gradient(
                    120deg,
                    #520404,
                    #ee0914,
                    #580000
                );

            color: white;
        }


        /* ============================= */
        /* CONTAINER */
        /* ============================= */

        .container {
            min-height: 100vh;
            padding: 40px 20px;
        }


        /* ============================= */
        /* CARD */
        /* ============================= */

        #card {
            width: 100%;
            max-width: 1200px;

            padding: 40px !important;

            background: rgba(15, 15, 15, 0.95);

            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.6),
                0 0 40px rgba(229, 9, 20, 0.08);

            backdrop-filter: blur(15px);

            transition: 0.3s ease;
        }

        #card:hover {
            border-color: rgba(229, 9, 20, 0.35);

            box-shadow:
                0 30px 70px rgba(0, 0, 0, 0.7),
                0 0 50px rgba(229, 9, 20, 0.12);
        }


        /* ============================= */
        /* TÍTULO */
        /* ============================= */

        h1 {
            color: #fff;

            font-size: clamp(30px, 5vw, 42px);
            font-weight: 800;

            letter-spacing: -1.5px;
            line-height: 1;

            margin-bottom: 35px !important;
        }

        h1::after {
            content: "";

            display: block;

            width: 55px;
            height: 4px;

            margin: 15px auto 0;

            border-radius: 10px;

            background: #e50914;
        }


        /* ============================= */
        /* TABELA */
        /* ============================= */

        .table-responsive {
            border-radius: 15px;
            overflow-x: auto;

            border: 1px solid #292929;
        }

        .table {
            margin-bottom: 0;

            min-width: 900px;

            color: #ddd;
            background: #111;
        }


        /* CABEÇALHO */

        .table thead {
            background: #1b1b1b;
        }

        .table thead th {
            padding: 17px 15px;

            color: #000;

            font-size: 13px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.5px;

            border-bottom: 2px solid #e50914;

            white-space: nowrap;
        }


        /* LINHAS */

        .table tbody tr {
            background: #111;

            transition: 0.2s ease;
        }

        .table tbody tr:hover {
            background: #1a1a1a;
        }

        .table tbody td {
            padding: 16px 15px;

            color: #000;

            font-size: 14px;

            border-color: #292929;

            vertical-align: middle;
        }


        /* ID */

        .table tbody td:first-child {
            color: #e50914;
            font-weight: 700;
        }


        /* EMAIL */

        .table tbody td:nth-child(3), td:nth-child(6) {
            font-weight: 600;
        }

        /* ============================= */
        /* BOTÕES */
        /* ============================= */

        .btn-editar,
        .btn-apagar {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-width: 75px;

            padding: 8px 14px;

            border-radius: 20px;

            font-family: 'Rubik', sans-serif;

            font-size: 12px;
            font-weight: 600;

            text-decoration: none;

            cursor: pointer;

            transition: 0.25s ease;
        }


        /* EDITAR */

        .btn-editar {
            margin-right: 5px;

            color: #fff;

            background: #292929;

            border: 1px solid #444;
        }

        .btn-editar:hover {
            color: #fff;

            background: #3a3a3a;

            border-color: #666;

            transform: translateY(-2px);
        }


        /* APAGAR */

        .btn-apagar {
            color: #fff;

            background: #e50914;

            border: 1px solid #e50914;
        }

        .btn-apagar:hover {
            background: #ff202b;

            border-color: #ff202b;

            transform: translateY(-2px);

            box-shadow:
                0 6px 15px rgba(229, 9, 20, 0.25);
        }


        /* ============================= */
        /* SCROLLBAR DA TABELA */
        /* ============================= */

        .table-responsive::-webkit-scrollbar {
            height: 8px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #111;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #444;

            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #e50914;
        }


        /* ============================= */
        /* RESPONSIVIDADE */
        /* ============================= */

        @media (max-width: 900px) {

            .container {
                padding: 30px 15px;
            }

            #card {
                padding: 30px 20px !important;
                border-radius: 20px;
            }

            h1 {
                font-size: 32px;
            }

        }


        @media (max-width: 600px) {

            .container {
                padding: 20px 10px;
            }

            #card {
                padding: 25px 15px !important;

                border-radius: 18px;
            }

            h1 {
                font-size: 28px;

                letter-spacing: -1px;

                margin-bottom: 28px !important;
            }

            .table thead th {
                padding: 14px 12px;

                font-size: 11px;
            }

            .table tbody td {
                padding: 13px 12px;

                font-size: 12px;
            }

            .btn-editar,
            .btn-apagar {
                min-width: 65px;

                padding: 7px 10px;

                font-size: 11px;
            }

        }


        @media (max-width: 380px) {

            #card {
                padding: 22px 12px !important;
            }

            h1 {
                font-size: 25px;
            }

        }

    </style>

</head>

<body>

    <div class="container d-flex justify-content-center align-items-center">

        <div class="card" id="card">

            <h1 class="text-center"> Lista de Interessados </h1>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="text-center">

                        <tr>
                            <th>Id</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Quantidade</th>
                            <th>Notificações</th>
                            <th>Ações</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% for(interessado of interessados) { %>

                            <tr class="text-center">

                                <td> <%= interessado.id %> </td>
                                <td> <%= interessado.username %> </td>
                                <td> <%= interessado.email %> </td>
                                <td> <%= interessado.telephone %> </td>
                                <td> <%= interessado.quantity %> </td>
                                <td> <%= interessado.notifications %> </td>

                                <td> <button onclick="apagarInteressado('<%= interessado.id %>')" class="btn-apagar"> Apagar </button> </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <script>

        async function apagarInteressado(id)
        {
            const url = "/api/deletar/" + id;

            const response = await fetch(url, 
            { 
                method:'DELETE' 
            });

            const data = await response.json();

            if(!response.ok)
            {
                console.log("Ocorreu um erro na requisição");
            }

            console.log(data);

            location.reload();
        }

    </script>

</body>

</html>